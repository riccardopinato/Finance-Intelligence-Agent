{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MarketEventDesignV1",
  "description": "Design-only - no market data provider integrated",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "instrument",
    "event_type",
    "event_time_utc",
    "ingested_at_utc",
    "provider_id",
    "provenance",
    "currency",
    "time_basis",
    "delay_state"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "instrument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "symbol",
        "exchange"
      ],
      "properties": {
        "symbol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48
        },
        "exchange": {
          "type": "string",
          "minLength": 2,
          "maxLength": 32
        },
        "isin": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "event_type": {
      "enum": [
        "quote",
        "bar",
        "dividend",
        "split",
        "earnings",
        "news"
      ]
    },
    "event_time_utc": {
      "type": "string",
      "format": "date-time"
    },
    "ingested_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "provider_id": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_url",
        "license_status"
      ],
      "properties": {
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "license_status": {
          "enum": [
            "UNREVIEWED",
            "REVIEWED",
            "APPROVED_FOR_SCOPED_USE",
            "BLOCKED"
          ]
        }
      }
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "time_basis": {
      "enum": [
        "OPEN",
        "HIGH",
        "LOW",
        "CLOSE",
        "BID",
        "ASK",
        "INDICATIVE",
        "EOD",
        "NOT_APPLICABLE"
      ]
    },
    "delay_state": {
      "enum": [
        "LIVE_LICENSED",
        "DELAYED",
        "EOD",
        "UNKNOWN"
      ]
    },
    "value": {
      "type": [
        "number",
        "null"
      ]
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
